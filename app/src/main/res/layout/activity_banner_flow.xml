<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/banner_ad_flow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_banner_flow_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banner Ad - Level 1 of 3"
                android:textColor="#202124"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_banner_flow_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="This screen displays an Adaptive Banner at the bottom. Click the button below to proceed to the next screen and test banner loading across consecutive levels."
                android:textColor="#5F6368"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_banner_flow_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Banner Status: Loading..."
                android:textColor="#1A73E8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Action Button to proceed to next level -->
            <Button
                android:id="@+id/btn_next_banner_level"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Proceed to Level 2 ➔" />

            <Button
                android:id="@+id/btn_banner_back_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Exit Flow / Back to Home" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Adaptive Banner at Bottom -->
    <com.example.ads.banner.BannerAdView
        android:id="@+id/banner_ad_flow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:autoLoadBanner="true"
        app:bannerSize="adaptive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
