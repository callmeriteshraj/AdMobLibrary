<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medium Rectangle Banner Ad"
            android:textColor="#202124"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Demonstrating 300x250 Medium Rectangle (MREC) Banner in XML."
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_reload_mrec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reload Medium Rectangle Banner" />

        <TextView
            android:id="@+id/tv_mrec_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Loading ad..."
            android:textColor="#1A73E8"
            android:textSize="13sp" />

        <!-- Card Container for Medium Rectangle Ad -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="300x250 Medium Rectangle Ad View"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Medium Rectangle BannerAdView Component -->
                <com.example.ads.banner.BannerAdView
                    android:id="@+id/banner_ad_medium_rectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:autoLoadBanner="true"
                    app:bannerSize="mediumRectangle" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Comparison / Info section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="About Medium Rectangle (MREC) Ads:"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="• Standard Size: 300 dp width × 250 dp height.\n• Ideal Placement: Inside scrollable feeds, content articles, end-of-level game summaries, and dashboard widgets.\n• Higher eCPM: Due to larger area, Medium Rectangle ads usually achieve higher eCPMs and click-through rates compared to standard 320x50 banners."
            android:textColor="#5F6368"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
